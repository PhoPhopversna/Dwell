# Environment variables used by the Dwell services (api-gateway, identity, product-catalog).
# All have local-dev defaults in each service's application.yml; set them per environment.

# ---------- Logging (all services) ----------
# Environment label/field on every log line: local | dev | staging | prod
APP_ENV=local
# Directory for <service>.log JSON files that Grafana Alloy ships to Loki.
# Run all services with the same LOG_DIR (default: ./logs relative to the working directory).
LOG_DIR=logs
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
# INFO = one line per request; DEBUG also logs "Request received"
LOG_LEVEL_ACCESS=INFO
LOG_MAX_FILE_SIZE=50MB
LOG_MAX_HISTORY=7
LOG_TOTAL_SIZE_CAP=1GB
# Console format: JSON by default. "logstash" or "ecs" are other built-in JSON formats.
LOG_CONSOLE_FORMAT=com.neo.logging.DwellJsonLogFormatter

# ---------- identity: Keycloak service account for admin API calls ----------
# A separate client (e.g. dwell-admin) so dwell-client (user logins) can run with full scope off.
# Required: identity won't start without it (the local profile defaults to dwell-admin).
KEYCLOAK_SERVICE_CLIENT_ID=dwell-admin
KEYCLOAK_SERVICE_CLIENT_SECRET=

# ---------- Gateway-only access (gateway, identity, product-catalog must match) ----------
GATEWAY_SECRET=change-me

# ---------- Identity: first admin (keep disabled in production) ----------
BOOTSTRAP_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=dwell_admin
BOOTSTRAP_ADMIN_EMAIL=dwell_admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# Observability stack (Loki/Alloy/Grafana): see docker/observability/.env.example

# ---------- scripts/dwell.sh ----------
# Spring profiles for identity ("local" creates the bootstrap admin; leave empty in production)
IDENTITY_PROFILES=local
# Extra JVM options for every service, e.g. -Xmx512m
JAVA_OPTS=
# Seconds to wait for each service to start listening
START_TIMEOUT=120
