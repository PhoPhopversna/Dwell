# Copy to .env (cd docker/observability && cp .env.example .env) and adjust.

# --- Where the Dwell services write their JSON log files (mounted read-only into Alloy) ---
# Must point at the same directory as the services' LOG_DIR. Relative to this folder.
DWELL_LOG_DIR=../../logs
# environment label used only for lines that carry no "environment" field
DWELL_ENV_DEFAULT=local

# --- Loki ---
LOKI_VERSION=3.4.3
LOKI_PORT=3100
# Retention (Loki duration). 168h = 7 days, 720h = 30 days
LOKI_RETENTION_PERIOD=168h
LOKI_INGESTION_RATE_MB=8
LOKI_INGESTION_BURST_MB=16
# Where Alloy pushes logs (change to ship to a remote/managed Loki)
LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push
# Where Grafana queries logs
LOKI_QUERY_URL=http://loki:3100

# --- Grafana Alloy ---
ALLOY_VERSION=v1.8.3
ALLOY_UI_PORT=12345

# --- Grafana ---
GRAFANA_VERSION=11.6.1
# 3000 is often taken locally
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
# Set your own; empty means "admin" (local only)
GRAFANA_ADMIN_PASSWORD=
