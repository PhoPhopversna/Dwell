{
  "uid": "dwell-logs",
  "title": "Dwell - Centralized Logs",
  "tags": [
    "dwell",
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "dwell-loki"
        },
        "query": {
          "label": "environment",
          "refId": "env",
          "type": 1
        },
        "definition": "label_values(environment)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".+",
        "refresh": 2
      },
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "dwell-loki"
        },
        "query": {
          "label": "service_name",
          "refId": "svc",
          "type": 1
        },
        "definition": "label_values(service_name)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".+",
        "refresh": 2
      },
      {
        "name": "level",
        "type": "custom",
        "query": "ERROR,WARN,INFO,DEBUG",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".+",
        "options": [
          {
            "text": "ERROR",
            "value": "ERROR",
            "selected": false
          },
          {
            "text": "WARN",
            "value": "WARN",
            "selected": false
          },
          {
            "text": "INFO",
            "value": "INFO",
            "selected": false
          },
          {
            "text": "DEBUG",
            "value": "DEBUG",
            "selected": false
          }
        ]
      },
      {
        "name": "correlationId",
        "type": "textbox",
        "label": "Correlation ID",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "search",
        "type": "textbox",
        "label": "Text search",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log volume by level",
      "datasource": {
        "type": "loki",
        "uid": "dwell-loki"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "dwell-loki"
          },
          "expr": "sum by (level) (count_over_time({service_name=~\"$service\", level=~\"$level\", environment=~\"$environment\"} [$__auto]))",
          "legendFormat": "{{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 request duration (ms) by service",
      "datasource": {
        "type": "loki",
        "uid": "dwell-loki"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "dwell-loki"
          },
          "expr": "quantile_over_time(0.95, {service_name=~\"$service\", environment=~\"$environment\"} | json | event=\"http_request_completed\" | unwrap durationMs [$__auto]) by (service_name)",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Logs",
      "datasource": {
        "type": "loki",
        "uid": "dwell-loki"
      },
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "dwell-loki"
          },
          "expr": "{service_name=~\"$service\", level=~\"$level\", environment=~\"$environment\"} |= \"$search\" | json | correlationId=~\"$correlationId.*\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    }
  ]
}