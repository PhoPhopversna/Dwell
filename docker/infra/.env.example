# Copy to .env (cd docker/infra && cp .env.example .env) and fill in. .env is git-ignored.

# MinIO root login (console at http://localhost:9001). Keep the values the data dir was created with.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=
# Host folder for MinIO data (absolute, or relative to this folder)
MINIO_DATA_DIR=./minio-data

# ---------- Keycloak (all optional locally: the defaults below are used when unset) ----------
# Master realm admin (console login, and what keycloak-init signs in with). Default admin / admin.
# Keycloak only reads it when its database is new; changing it later doesn't change the password.
#KC_ADMIN_USER=admin
#KC_ADMIN_PASSWORD=admin
#KEYCLOAK_REALM=Dwell
# Client secrets keycloak-init sets in Keycloak. Default: identity's local dev defaults.
# Outside local, set your own here AND the same values in identity's environment.
# Changing one and re-running keycloak-init rotates it (restart identity afterwards).
#KEYCLOAK_CLIENT_SECRET=
#KEYCLOAK_SERVICE_CLIENT_SECRET=
